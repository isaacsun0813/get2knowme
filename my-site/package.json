{
  "name": "my-site",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src tests scripts playwright.config.ts",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "inspect": "node scripts/inspect-site.mjs",
    "validate:models": "node scripts/validate-models.mjs",
    "review:capture": "node scripts/capture-review.mjs",
    "build:night-lights": "node scripts/build-night-lights.mjs",
    "check:night-lights": "node scripts/build-night-lights.mjs --check",
    "format": "prettier --write src tests scripts playwright.config.ts next.config.ts",
    "format:check": "prettier --check src tests scripts playwright.config.ts next.config.ts",
    "profile:rendering": "node scripts/profile-rendering.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.0.5",
    "@react-three/fiber": "^9.1.1",
    "lucide-react": "^0.525.0",
    "next": "^15.5.28",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.175.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.1.11",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^15.5.28",
    "gltf-validator": "^2.0.0-dev.3.10",
    "prettier": "3.6.2",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "8.5.30",
    "brace-expansion@1": "1.1.21",
    "picomatch@2": "2.3.2"
  }
}
